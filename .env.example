# =========[ General Settings ]=========
PROJECT_NAME=main
DEBUG=false
# Backend log level (trace|debug|info|warn|error). Empty = debug when DEBUG=true, else info.
LOG_LEVEL=
# Serve Swagger UI at /api/__hidden_swagger and the spec at /api/openapi.json (logged-in users only).
OPENAPI_ENABLED=true

# =========[ Server Ports ]=========
WEB_SERVER_PORT=8787
REVERSE_SERVER_SSH_PORT=24242
# Only if an L4 (TCP) proxy sits in front of REVERSE_SERVER_SSH_PORT (nginx `stream` with `proxy_protocol on;`,
# HAProxy `mode tcp` + `send-proxy-v2`, a cloud NLB with proxy protocol): its address(es), comma separated
# (IPs or CIDRs). A PROXY protocol v1/v2 header from them is detected automatically and gives the device's real
# IP; a connection from them without one is handled as a direct connection. Headers from any other source are
# never read, so only list addresses that untrusted clients cannot connect from. Empty = off.
GATEWAY_PROXY_PROTOCOL_FROM=

# =========[ OAuth / Social Login ]=========
SOCIAL_GOOGLE_CLIENT_ID=376808175534-d6mefo6b1kqih3grjjose2euree2g3cs.apps.googleusercontent.com

# =========[ Domain / Server ]=========
SERVER_DOMAIN=localhost
# Public base URL as browsers and MCP clients see it (e.g. https://telepy.example.com). It is the
# OAuth issuer for MCP connectors and the passkey (WebAuthn) origin; empty = derived from the request
# (X-Forwarded-Proto/Host). Passkeys only work on a domain name with https, or on localhost.
PUBLIC_URL=
# How many trusted reverse proxies sit in front of the backend, Traefik included. The client IP shown in the
# sign-in history is read from X-Forwarded-For, counting this many hops from the right: 1 = only this
# compose's Traefik; 2 = an upstream TLS proxy / load balancer in front of it. Too high lets clients spoof it.
TRUSTED_PROXY_HOPS=1
# Optional: take the client IP from this header instead (e.g. CF-Connecting-IP behind Cloudflare). Only set it
# if the upstream always overwrites the header and the server cannot be reached around it.
CLIENT_IP_HEADER=
# Offline IP geolocation (country + network owner next to device / sign-in IPs). Run `./telepy.sh geoip`
# monthly to download DB-IP Lite into ./telepy-data/geoip, then restart the backend. Empty = /data/geoip.
# Lookups happen on the server; no IP is sent anywhere.
GEOIP_DIR=

# =========[ Internal / Secrets ]=========
INTERNAL_API_TOKEN=your-random-secret-string
# JWT signing key. Empty keeps the legacy default so existing sessions survive an upgrade;
# set a long random string in production (everyone has to log in again once).
SECRET_KEY=
