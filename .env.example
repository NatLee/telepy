# Copy to .env and edit. docker-compose.yml and the frontend's `npm run dev` read this file.
# Keep one VAR=value per line with no quotes, spaces or trailing comments.
# Lines starting with # are ignored; a commented-out variable shows its default.
#
# Variables marked "[Site settings → Server]" are optional: the same setting can be changed as an admin under
# Site settings → Server without a restart. Leave them empty to edit them there. A value here wins and locks that
# field on the page (order: this file → Site settings → built-in default).

# =========[ General Settings ]=========
# Suffix of the container and network names (telepy-web-<name>, …); give each stack on one host its own.
PROJECT_NAME=main
# true = debug logging.
DEBUG=false
# [Site settings → Server] Backend log level (trace|debug|info|warn|error) or a full tracing EnvFilter directive.
# Empty = the Site setting, else debug when DEBUG=true, else info.
LOG_LEVEL=
# [Site settings → Server] Serve Swagger UI at /api/__hidden_swagger and the spec at /api/openapi.json (logged-in
# users only); true / false. Empty = the Site setting (default on).
OPENAPI_ENABLED=

# =========[ Server Ports ]=========
# Port Traefik publishes for the web UI, REST API and WebSockets (plain http; put a TLS proxy in front for https).
WEB_SERVER_PORT=8787
# Port devices dial for their reverse SSH tunnel; it is published to the backend's built-in SSH gateway (2222 inside).
REVERSE_SERVER_SSH_PORT=24242
# Only if an L4 (TCP) proxy sits in front of REVERSE_SERVER_SSH_PORT (nginx `stream` with `proxy_protocol on;`,
# HAProxy `mode tcp` + `send-proxy-v2`, a cloud NLB with proxy protocol): its address(es), comma separated
# (IPs or CIDRs). A PROXY protocol v1/v2 header from them is detected automatically and gives the device's real
# IP; a connection from them without one is handled as a direct connection. Headers from any other source are
# never read, so only list addresses that untrusted clients cannot connect from.
# [Site settings → Server] Empty = the Site setting (default off).
GATEWAY_PROXY_PROTOCOL_FROM=
# When a device connects, Telepy logs in once with the service key (the tunnel's default account) and runs a
# read-only script for its hostname, LAN addresses, public IP and basic facts (OS, uptime, memory, disk, load).
# When the gateway does not see a public address, the device asks this server's own /api/whoami (needs PUBLIC_URL
# or SERVER_DOMAIN reachable over https from the device); only when that answer is not public either (a proxy or
# Docker in front of Telepy) does it ask the lookup URL in Site settings (default https://api.ipify.org; blank
# there = never ask a third party). Asked once per connection (10-minute cool-down) and at most daily while
# connected. false = off.
# [Site settings → Server] Empty = the Site setting (default on).
DEVICE_PROBE=
# Each tunnel moves to its own service key; once every tunnel on a machine logs in with its own key, Telepy removes
# the old shared key (ssh/backend_ssh_key) from that machine. true = never remove it — for when another Telepy server
# (e.g. the previous one, running in parallel during a move) still logs in to the same devices with that key.
# [Site settings → Server] Empty = the Site setting (default false).
KEEP_SHARED_SERVICE_KEY=

# =========[ OAuth / Social Login ]=========
# [Site settings → Server] Google OAuth client ID for "Sign in with Google": the sign-in button uses it and Google
# sign-ins are checked against it. Set here it wins and locks the field on the Settings page; empty = the Site
# setting (empty there = no Google sign-in). The frontend image also bakes it in at build time as a fallback for
# older backends.
SOCIAL_GOOGLE_CLIENT_ID=376808175534-d6mefo6b1kqih3grjjose2euree2g3cs.apps.googleusercontent.com

# =========[ Domain / Server ]=========
# Host name of this server. It names the server in the SSH configs and pinned known_hosts lines, and devices and
# laptops connect their SSH to it unless SSH_SERVER_DOMAIN says otherwise.
SERVER_DOMAIN=localhost
# Optional: a separate name for SSH (the REVERSE_SERVER_SSH_PORT below). Needed when the web name goes through a
# proxy that only carries web ports (Cloudflare's orange cloud, another CDN, an HTTP load balancer or tunnel):
# give this server a second name that points straight at it (e.g. telepy-ssh.example.com) and put it here. Empty = the same as SERVER_DOMAIN. Set here it wins and locks
# the field on Site settings -> Server. Only new scripts and SSH configs use it; installed devices keep their name.
SSH_SERVER_DOMAIN=
# Public base URL as browsers and MCP clients see it (e.g. https://telepy.example.com). It is the
# OAuth issuer for MCP connectors, the passkey (WebAuthn) origin and the base of the one-command join URL;
# empty = derived from the request (X-Forwarded-Proto/Host). Passkeys only work on a domain name with https,
# or on localhost.
# [Site settings → Server] Empty = the Site setting, else derived from the request.
PUBLIC_URL=
# Which entries of X-Forwarded-For are proxies (the client IP shown in the sign-in history is the one before them).
# auto (default): every internal address at the right end is a proxy — Traefik, an Nginx Proxy Manager / Caddy /
# nginx in front of it — and the first public address from the right is the visitor; nothing to count. A number
# skips exactly that many entries from the right, Traefik included (1 = only this compose's Traefik, 2 = plus an
# upstream TLS proxy); set one when a proxy in front has a public address, or to stop visitors on your own
# network from choosing their recorded address. Too high a number lets clients spoof it. Check the result as an
# admin under Admin → Server health → "How Telepy sees your address".
# [Site settings → Server → Visitor addresses] Empty = the Site setting (default auto).
TRUSTED_PROXY_HOPS=
# Optional: take the client IP from this header instead (e.g. CF-Connecting-IP behind Cloudflare). Only set it
# if the upstream always overwrites the header and the server cannot be reached around it. Behind Cloudflare the
# Site setting "Cloudflare" (default auto) already uses CF-Connecting-IP when the request came from Cloudflare.
# [Site settings → Server → Visitor addresses] Empty = the Site setting (default none).
CLIENT_IP_HEADER=
# Offline IP geolocation (country + network owner next to device / sign-in IPs): run
# `docker compose exec backend telepy-server geoip` monthly to download DB-IP Lite, then restart the backend. LAN hosts'
# NIC vendors: `docker compose exec backend telepy-server oui` once in a while. Lookups happen on the server; no IP is
# sent anywhere. Where the backend reads them, as paths inside the container (empty = /data/geoip and /data/oui, which
# live under ./telepy-data on the host); the two download commands write to the same paths.
GEOIP_DIR=
OUI_DIR=

# =========[ Remote browser / remote desktop ]=========
# Basic Auth login the backend uses for KasmVNC in the kasm-browser container (internal network only, never
# published). The password needs at least 6 characters and is baked into the kasm-browser image, so after
# changing either run: docker compose up -d --build kasm-browser backend
# KASM_WS_USER=telepy
# KASM_WS_PASSWORD=telepyvnc
# Start page and language of a remote browser, used only when Site settings → Remote browser leaves them blank
# (they are filled in by default).
# REMOTE_BROWSER_HOMEPAGE=https://www.google.com
# REMOTE_BROWSER_LANG=zh-TW
# Log level of guacd, the RDP / VNC engine (error|warning|info|debug|trace).
# GUACD_LOG_LEVEL=info

# =========[ Internal / Secrets ]=========
# Shared secret between the backend and the kasm-browser session-manager. Set a long random string.
INTERNAL_API_TOKEN=your-random-secret-string
# Signs sign-in tokens and seals stored secrets (authenticator-app 2FA, saved logins, per-tunnel service keys,
# webhook secrets). Empty keeps the legacy default (a warning at startup). Set a long random string BEFORE real
# use: changing it later signs everyone out, and the secrets sealed with the old key can no longer be read
# (2FA users fall back to passkeys / recovery codes, tunnels to the shared service key).
SECRET_KEY=

# =========[ Advanced: read by the backend, not passed by docker-compose.yml ]=========
# Setting these here has no effect until you also add them under the backend's `environment:` in docker-compose.yml.
# Most simultaneous SSH connections the gateway accepts.
# GATEWAY_MAX_CONNECTIONS=4096
# Seconds a device has to finish the SSH handshake and log in.
# GATEWAY_LOGIN_GRACE_SECS=60
# Seconds between the latency / health probes through each tunnel.
# GATEWAY_PROBE_INTERVAL_SECS=15
# Terminal / file manager / remote browser sockets: ping interval, and how long without an answer ends the session.
# WS_PING_INTERVAL_SECS=20
# WS_PEER_TIMEOUT_SECS=40
